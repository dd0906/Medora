# Optional settings for Medora. They are read from environment variables, not
# from this file. In PowerShell, set one with:  $env:MEDORA_API_KEY = "value"

# Saved model to serve. Set this after training: the default below is the name of
# the original run's model, and models aren't included in the repository.
# MEDORA_MODEL_PATH=models/medora_random_forest_20261101-173518.joblib

# SQLite database file. Defaults to data/medora.db.
# MEDORA_DATABASE_PATH=data/medora.db

# JSON file overriding risk scoring settings. See docs/architecture.md.
# MEDORA_RISK_CONFIG=risk_config.json

# Require this value in an X-API-Key header on routes that change data.
# MEDORA_API_KEY=

# Where the dashboard finds the API. Defaults to http://127.0.0.1:8000.
# MEDORA_API_URL=http://127.0.0.1:8000

# Other data, model, and evaluation output folders.
# MEDORA_DATA_DIR=data
# MEDORA_MODEL_DIR=models
# MEDORA_EVALUATION_DIR=experiments/evaluation
